{
  "name": "git-amida",
  "displayName": "GitAmida",
  "description": "Browse the commit graph and file history in the Panel, and open changes in native diffs.",
  "icon": "media/git-amida-marketplace.png",
  "version": "0.0.3",
  "private": true,
  "publisher": "hirosco",
  "license": "SEE LICENSE IN LICENSE",
  "author": {
    "name": "Hiroshi Kudo",
    "url": "https://hirosco.dev"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hirosco/vscode-git-amida.git"
  },
  "homepage": "https://github.com/hirosco/vscode-git-amida",
  "bugs": {
    "url": "https://github.com/hirosco/vscode-git-amida/issues"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "GitAmida runs the Git executable and can perform explicitly requested repository and file mutations."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "GitAmida requires a local file-system checkout and the Git executable in the Extension Host."
    }
  },
  "extensionDependencies": [
    "vscode.git"
  ],
  "categories": [
    "SCM Providers",
    "Visualization"
  ],
  "keywords": [
    "git",
    "git history",
    "commit graph",
    "file history",
    "diff",
    "cursor"
  ],
  "galleryBanner": {
    "color": "#E9BD4D",
    "theme": "light"
  },
  "pricing": "Free",
  "qna": false,
  "main": "./dist/src/extension.js",
  "files": [
    "dist/src/**/*.js",
    "dist/webview/**/*.js",
    "media/**",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "contributes": {
    "colors": [
      {
        "id": "gitAmida.headRefColor",
        "description": "Color of the GitAmida inline local HEAD indicator.",
        "defaults": {
          "dark": "#E2C08D",
          "light": "#895503",
          "highContrast": "#FFD370",
          "highContrastLight": "#895503"
        }
      },
      {
        "id": "gitAmida.tagRefColor",
        "description": "Color of GitAmida tag indicators.",
        "defaults": {
          "dark": "#8C8C8C",
          "light": "#8E8E90",
          "highContrast": "#A7A8A9",
          "highContrastLight": "#8E8E90"
        }
      }
    ],
    "commands": [
      {
        "command": "gitAmida.open",
        "title": "GitAmida: Open",
        "icon": "$(git-commit)"
      },
      {
        "command": "gitAmida.refresh",
        "title": "GitAmida: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "gitAmida.openInDifftool",
        "title": "GitAmida: Open in Git Difftool",
        "icon": "$(link-external)"
      },
      {
        "command": "gitAmida.openInMergetool",
        "title": "GitAmida: Open in Git Mergetool",
        "icon": "$(tools)"
      },
      {
        "command": "gitAmida.openInDifftoolFromChangedFile",
        "title": "Open in Git Difftool",
        "category": "GitAmida"
      },
      {
        "command": "gitAmida.openFileHistory",
        "title": "GitAmida: Show File History",
        "icon": "$(history)"
      },
      {
        "command": "gitAmida.openFileHistoryFromChangedFile",
        "title": "Show File History",
        "category": "GitAmida"
      },
      {
        "command": "gitAmida.showInRepositoryHistory",
        "title": "Show in Repository History",
        "category": "GitAmida"
      },
      {
        "command": "gitAmida.openChanges",
        "title": "Open Changes",
        "category": "GitAmida",
        "icon": "$(diff)"
      },
      {
        "command": "gitAmida.openChangedFileInWorkingTree",
        "title": "Open File in Working Tree",
        "category": "GitAmida"
      },
      {
        "command": "gitAmida.copyChangedFileName",
        "title": "Copy File Name",
        "category": "GitAmida"
      },
      {
        "command": "gitAmida.copyChangedFileRelativePath",
        "title": "Copy Relative Path",
        "category": "GitAmida"
      },
      {
        "command": "gitAmida.switchBranch",
        "title": "Switch Branch…",
        "category": "GitAmida",
        "icon": "$(git-branch)"
      },
      {
        "command": "gitAmida.restoreAfterFile",
        "title": "Restore Selected File from After Version…",
        "category": "GitAmida"
      },
      {
        "command": "gitAmida.restoreBeforeFile",
        "title": "Restore Selected File from Before Version…",
        "category": "GitAmida"
      }
    ],
    "submenus": [
      {
        "id": "gitAmida.restoreFile",
        "label": "Restore Working Tree File"
      },
      {
        "id": "gitAmida.copyFile",
        "label": "Copy"
      }
    ],
    "viewsContainers": {
      "panel": [
        {
          "id": "gitAmida",
          "title": "GitAmida",
          "icon": "media/git-amida.svg"
        }
      ]
    },
    "views": {
      "gitAmida": [
        {
          "id": "gitAmida.history",
          "name": "History",
          "type": "webview",
          "icon": "media/git-amida.svg",
          "contextualTitle": "GitAmida"
        }
      ]
    },
    "menus": {
      "editor/title": [
        {
          "command": "gitAmida.openFileHistory",
          "when": "resourceScheme == file",
          "group": "navigation"
        },
        {
          "command": "gitAmida.openInDifftool",
          "when": "resourceScheme =~ /^git-amida$|^git-amida-blob$/",
          "group": "navigation@10"
        },
        {
          "command": "gitAmida.openInMergetool",
          "when": "gitAmida.activeConflictSupportsMergetool",
          "group": "navigation@11"
        }
      ],
      "view/title": [
        {
          "command": "gitAmida.refresh",
          "when": "view == gitAmida.history",
          "group": "navigation@1"
        }
      ],
      "webview/context": [
        {
          "command": "gitAmida.openChanges",
          "when": "webviewId == 'gitAmida.history' && webviewSection == 'changedFile'",
          "group": "navigation@1"
        },
        {
          "command": "gitAmida.openFileHistoryFromChangedFile",
          "when": "webviewId == 'gitAmida.history' && webviewSection == 'changedFile'",
          "group": "navigation@3"
        },
        {
          "command": "gitAmida.openInDifftoolFromChangedFile",
          "when": "webviewId == 'gitAmida.history' && webviewSection == 'changedFile' && gitAmidaCanOpenDifftool",
          "group": "navigation@4"
        },
        {
          "command": "gitAmida.openChangedFileInWorkingTree",
          "when": "webviewId == 'gitAmida.history' && webviewSection == 'changedFile'",
          "group": "navigation@2"
        },
        {
          "submenu": "gitAmida.copyFile",
          "when": "webviewId == 'gitAmida.history' && webviewSection == 'changedFile'",
          "group": "navigation@5"
        },
        {
          "submenu": "gitAmida.restoreFile",
          "when": "webviewId == 'gitAmida.history' && webviewSection == 'changedFile' && gitAmidaCanRestoreFile",
          "group": "navigation@6"
        },
        {
          "command": "gitAmida.switchBranch",
          "when": "webviewId == 'gitAmida.history' && webviewSection == 'commit' && gitAmidaHasSwitchableBranch",
          "group": "navigation"
        },
        {
          "command": "gitAmida.showInRepositoryHistory",
          "when": "webviewId == 'gitAmida.history' && webviewSection == 'fileRevision'",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "gitAmida.openFileHistory",
          "when": "resourceScheme == file && !explorerResourceIsFolder",
          "group": "git"
        }
      ],
      "commandPalette": [
        {
          "command": "gitAmida.openFileHistoryFromChangedFile",
          "when": "false"
        },
        {
          "command": "gitAmida.openInDifftoolFromChangedFile",
          "when": "false"
        },
        {
          "command": "gitAmida.openInMergetool",
          "when": "false"
        },
        {
          "command": "gitAmida.openChangedFileInWorkingTree",
          "when": "false"
        },
        {
          "command": "gitAmida.copyChangedFileName",
          "when": "false"
        },
        {
          "command": "gitAmida.copyChangedFileRelativePath",
          "when": "false"
        },
        {
          "command": "gitAmida.showInRepositoryHistory",
          "when": "false"
        }
      ],
      "gitAmida.copyFile": [
        {
          "command": "gitAmida.copyChangedFileName",
          "group": "navigation@1"
        },
        {
          "command": "gitAmida.copyChangedFileRelativePath",
          "group": "navigation@2"
        }
      ],
      "gitAmida.restoreFile": [
        {
          "command": "gitAmida.restoreAfterFile",
          "when": "gitAmidaCanRestoreAfterFile",
          "group": "navigation@1"
        },
        {
          "command": "gitAmida.restoreBeforeFile",
          "when": "gitAmidaCanRestoreBeforeFile",
          "group": "navigation@2"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "npm run build:extension && npm run build:webview",
    "build:extension": "tsc -p tsconfig.json",
    "build:webview": "tsc -p tsconfig.webview.json",
    "check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.webview.json",
    "test": "npm run build && node --test dist/test/*.test.js",
    "package:inspect": "vsce ls --no-dependencies",
    "package:vsix": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "24.8.1",
    "@types/vscode": "1.100.0",
    "@vscode/vsce": "3.9.2",
    "typescript": "5.9.3"
  },
  "allowScripts": {
    "@vscode/vsce-sign@2.0.9": false,
    "keytar@7.9.0": false
  },
  "packageManager": "npm@11.16.0"
}
